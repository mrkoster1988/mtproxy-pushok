POSTGRES_DB=mtproxy_pushok
POSTGRES_USER=mtproxy_pushok
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
DATABASE_URL=postgresql://mtproxy_pushok:REPLACE_WITH_LONG_RANDOM_SECRET@db:5432/mtproxy_pushok
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN
SESSION_SIGNING_KEY=REPLACE_WITH_ANOTHER_RANDOM_SECRET
# Отдельный секрет 256 бит: openssl rand -hex 32 (должен совпадать у API и бота).
BOT_INTERNAL_SECRET=REPLACE_WITH_64_HEX_RANDOM_CHARACTERS

TELEGRAM_BOT_USERNAME=mtproxy_pushok_bot
OFFICIAL_AD_CHANNEL_URL=https://t.me/pushok_proxy
# Опционально: числовой Telegram ID оператора для автоматических уведомлений.
# Должен иметь роль admin или operator в PostgreSQL и предварительно начать чат с ботом.
BOT_OPERATOR_TELEGRAM_ID=

# Реквизиты в Base64; мастер setup.sh заполняет автоматически.
PAYMENT_INSTRUCTIONS_B64=
