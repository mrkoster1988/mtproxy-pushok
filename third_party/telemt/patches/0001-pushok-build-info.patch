+//! Pushok-specific non-network build provenance. Modification of Telemt upstream.
+//!
+//! Base: Telemt 3.5.17, commit 66708d2866f3f3a4541c4fa67984d408e71a8af4.
+//! Pushok patch: cli-build-info-001. No request processing, proxy or network changes.
+
+pub const BUILD_INFO_JSON: &str = r#"{"product":"Pushok Source Core","version":"0.027","based_on":"Telemt 3.5.17","upstream_commit":"66708d2866f3f3a4541c4fa67984d408e71a8af4","patch":"cli-build-info-001","proxy_started":false}"#;
+
+#[cfg(test)]
+mod tests {
+    use super::BUILD_INFO_JSON;
+
+    #[test]
+    fn provenance_contains_explicit_fork_marker() {
+        assert!(BUILD_INFO_JSON.contains("Pushok Source Core"));
+        assert!(BUILD_INFO_JSON.contains("cli-build-info-001"));
+        assert!(BUILD_INFO_JSON.contains("66708d2866f3f3a4541c4fa67984d408e71a8af4"));
+        assert!(BUILD_INFO_JSON.contains("\"proxy_started\":false"));
+    }
+}
